<?xml version="1.0" encoding="utf-8"?>
<!-- Core is on the home network over plain HTTP. Integrity does not depend on the
     network: rules are signed by Core and requests by this device (docs/agent_protocol.md). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
